{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "direction",
  "type": "registry:block",
  "title": "Direction",
  "description": "LTR/RTL direction context for layout and composition.",
  "author": "Wensity <hey@wensity.com>",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/wensity/lib/utils.ts",
      "type": "registry:lib",
      "target": "@lib/utils.ts",
      "content": "import { type ClassValue, clsx } from \"clsx\";\nimport { twMerge } from \"tailwind-merge\";\n\nexport function cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n"
    },
    {
      "path": "registry/wensity/direction.tsx",
      "type": "registry:component",
      "target": "@components/wensity/direction.tsx",
      "content": "\"use client\";\n\nimport * as React from \"react\";\nimport { DirectionProvider } from \"@base-ui/react/direction-provider\";\nimport { useRender } from \"@base-ui/react/use-render\";\nimport { cn } from \"@/lib/utils\";\n\n/* ─── Types ─────────────────────────────────────────────────── */\n\nexport type DirectionValue = \"ltr\" | \"rtl\";\n\nexport interface DirectionProps {\n  /** Explicit direction. When omitted with `dynamic`, determined from `lang`. */\n  direction?: DirectionValue;\n  /** Auto-detect direction from the `lang` prop. */\n  dynamic?: boolean;\n  /** BCP 47 language tag used with `dynamic` mode (e.g. \"en\", \"ar\", \"he\"). */\n  lang?: string;\n  /** Merge onto the child element instead of wrapping in a div. */\n  asChild?: boolean;\n  /** Additional class name on the wrapper. */\n  className?: string;\n  children?: React.ReactNode;\n}\n\n/* ─── RTL language set ──────────────────────────────────────── */\n\nconst RTL_LANGUAGES = new Set([\n  \"ae\", \"ar\", \"arc\", \"bcc\", \"bqi\", \"ckb\", \"dv\", \"fa\", \"glk\", \"ha\",\n  \"he\", \"khw\", \"ks\", \"ku\", \"mzn\", \"pnb\", \"ps\", \"sd\", \"syr\", \"ug\",\n  \"ur\", \"uz_AF\", \"yi\",\n]);\n\nfunction isRTL(lang?: string): boolean {\n  if (!lang) return false;\n  const primary = lang.split(\"-\")[0].toLowerCase();\n  return RTL_LANGUAGES.has(primary);\n}\n\n/* ─── Context ───────────────────────────────────────────────── */\n\ntype DirectionContextValue = {\n  direction: DirectionValue;\n};\n\nconst DirectionContext = React.createContext<DirectionContextValue>({\n  direction: \"ltr\",\n});\n\n/** Wensity public API — returns `{ direction }`. */\nexport function useDirection(): DirectionContextValue {\n  return React.useContext(DirectionContext);\n}\n\n/* ─── Direction ─────────────────────────────────────────────── */\n\nexport function Direction({\n  direction: directionProp,\n  dynamic = false,\n  lang,\n  asChild = false,\n  className,\n  children,\n}: DirectionProps) {\n  const resolved = React.useMemo<DirectionValue>(() => {\n    if (directionProp) return directionProp;\n    if (dynamic && lang) return isRTL(lang) ? \"rtl\" : \"ltr\";\n    return \"ltr\";\n  }, [directionProp, dynamic, lang]);\n\n  const asChildElement =\n    asChild && React.isValidElement(children) ? children : null;\n\n  const asChildRendered = useRender({\n    enabled: Boolean(asChildElement),\n    render: asChildElement ?? undefined,\n    props: {\n      dir: resolved,\n      className: cn(\n        asChildElement && React.isValidElement(asChildElement)\n          ? (asChildElement.props as { className?: string }).className\n          : undefined,\n        className,\n      ),\n    },\n  });\n\n  return (\n    <DirectionProvider direction={resolved}>\n      <DirectionContext.Provider value={{ direction: resolved }}>\n        {asChildRendered ? (\n          asChildRendered\n        ) : (\n          <div dir={resolved} className={cn(className)}>\n            {children}\n          </div>\n        )}\n      </DirectionContext.Provider>\n    </DirectionProvider>\n  );\n}\n"
    }
  ],
