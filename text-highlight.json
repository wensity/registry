      "primitive-edge": "rgba(255, 255, 255, 0.09)",
      "primitive-catchlight": "rgba(255, 255, 255, 0.16)",
      "primitive-groove-shadow": "rgba(0, 0, 0, 0.55)",
      "primitive-groove-highlight": "rgba(255, 255, 255, 0.05)",
      "primitive-shadow-drop": "0 1px 1px -0.5px rgba(0, 0, 0, 0.6), 0 2px 4px -1px rgba(0, 0, 0, 0.4)",
      "primitive-shadow-recess": "inset 0 2px 3px -1px rgba(0, 0, 0, 0.5)",
      "primitive-control-face": "var(--primitive-frame-face)",
      "primitive-field-face": "var(--primitive-frame-face)",
      "primitive-well": "rgba(0, 0, 0, 0.35)",
      "primitive-shadow-well": "inset 0 1px 2px 0 rgba(0, 0, 0, 0.45)",
      "primitive-tint-hover": "rgba(255, 255, 255, 0.06)",
      "primitive-tint-press": "rgba(0, 0, 0, 0.2)",
      "primitive-footer": "color-mix(in srgb, var(--primitive-surface-elevated) 97%, white)",
      "primitive-overlay-face": "color-mix(in srgb, var(--primitive-surface-overlay) 94%, white)",
      "primitive-frame-face": "color-mix(in srgb, var(--primitive-surface-elevated) 97%, white)",
      "primitive-z-overlay": "100",
      "primitive-z-popover": "130",
      "primitive-z-toast": "140",
      "primitive-backdrop": "rgba(0, 0, 0, 0.6)",
      "primitive-motion-fast": "80ms",
      "primitive-motion-fast-exit": "60ms",
      "primitive-motion-moderate": "160ms",
      "primitive-motion-moderate-exit": "120ms",
      "primitive-motion-slow": "240ms",
      "primitive-motion-slow-exit": "160ms",
      "primitive-ease": "cubic-bezier(0.23, 1, 0.32, 1)"
    }
  },
  "css": {
    "@layer components": {
      "[data-surface]": {
        "--surface-tint": "transparent",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--surface-rim)",
        "border-top-color": "var(--surface-rim-top)",
        "background-color": "var(--surface-face)",
        "background-image": "linear-gradient(var(--surface-tint), var(--surface-tint))",
        "--tw-shadow": "var(--surface-depth)",
        "box-shadow": "var(--tw-inset-shadow, 0 0 #0000), var(--tw-inset-ring-shadow, 0 0 #0000), var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)"
      },
      "[data-surface=\"control\"]": {
        "--surface-face": "var(--primitive-control-face)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-catchlight)",
        "--surface-depth": "var(--primitive-shadow-drop)"
      },
      "[data-surface=\"field\"]": {
        "--surface-face": "var(--primitive-field-face)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-catchlight)",
        "--surface-depth": "var(--primitive-shadow-drop)"
      },
      "[data-surface=\"fill\"]": {
        "--surface-face": "var(--primitive-control-solid)",
        "--surface-rim": "color-mix(in srgb, var(--surface-face) 88%, black)",
        "--surface-rim-top": "color-mix(in srgb, var(--surface-face) 80%, white)",
        "--surface-depth": "var(--primitive-shadow-drop)"
      },
      "[data-surface=\"flat\"], [data-surface=\"toggle\"], [data-surface=\"toggle-fill\"]": {
        "--surface-face": "transparent",
        "--surface-rim": "transparent",
        "--surface-rim-top": "transparent",
        "--surface-depth": "0 0 #0000"
      },
      "[data-surface=\"toggle\"]:is([data-pressed]:not([data-pressed=\"false\"]), [aria-pressed=\"true\"])": {
        "--surface-face": "var(--primitive-control-face)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-catchlight)",
        "--surface-depth": "var(--primitive-shadow-drop)"
      },
      "[data-surface=\"toggle-fill\"]:is([data-pressed]:not([data-pressed=\"false\"]), [aria-pressed=\"true\"])": {
        "--surface-face": "var(--primitive-control-solid)",
        "--surface-rim": "color-mix(in srgb, var(--surface-face) 88%, black)",
        "--surface-rim-top": "color-mix(in srgb, var(--surface-face) 80%, white)",
        "--surface-depth": "var(--primitive-shadow-drop)"
      },
      "[data-surface=\"well\"]": {
        "--surface-face": "var(--primitive-well)",
        "--surface-rim": "transparent",
        "--surface-rim-top": "transparent",
        "--surface-depth": "var(--primitive-shadow-well)"
      },
      "[data-surface=\"frame\"]": {
        "--surface-face": "var(--primitive-frame-face)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-catchlight)",
        "--surface-depth": "0 0 #0000"
      },
      "[data-surface=\"panel\"]": {
        "--surface-face": "var(--primitive-surface-elevated)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-edge)",
        "--surface-depth": "var(--primitive-shadow-raised)"
      },
      "[data-surface=\"overlay\"]": {
        "--surface-face": "var(--primitive-overlay-face)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-edge)",
        "--surface-depth": "var(--primitive-shadow-overlay)"
      },
      "[data-surface=\"modal\"]": {
        "--surface-face": "var(--primitive-surface-elevated)",
        "--surface-rim": "var(--primitive-edge)",
        "--surface-rim-top": "var(--primitive-edge)",
        "--surface-depth": "var(--primitive-shadow-modal)"
      },
      "[data-surface=\"footer\"]": {
        "--surface-face": "var(--primitive-footer)",
        "--surface-rim": "transparent",
        "--surface-rim-top": "transparent",
        "--surface-depth": "0 0 #0000",
        "border-width": "0",
        "background-image": "linear-gradient(to bottom, var(--primitive-groove-shadow) 0 1px, var(--primitive-groove-highlight) 1px 2px)",
        "background-size": "100% 2px",
        "background-repeat": "no-repeat",
        "background-position": "top"
      },
      "@media (hover: hover)": {
        "[data-surface]:where(button, a[href], summary, label, [role=\"button\"], [role=\"tab\"], [role=\"combobox\"], [role=\"option\"], [role=\"menuitem\"]):where(:not(:disabled, [data-disabled], [aria-disabled=\"true\"])):hover": {
          "--surface-tint": "var(--primitive-tint-hover)"
        },
        ":is([data-surface=\"control\"], [data-surface=\"field\"]):is([data-pressed]:not([data-pressed=\"false\"]), [aria-pressed=\"true\"]):where(:not(:disabled, [data-disabled], [aria-disabled=\"true\"])):hover": {
          "--surface-tint": "var(--primitive-tint-hover)"
        }
      },
      ":is([data-surface=\"control\"], [data-surface=\"field\"]):is([data-pressed]:not([data-pressed=\"false\"]), [aria-pressed=\"true\"])": {
        "--surface-tint": "var(--primitive-tint-press)",
        "--surface-rim-top": "var(--surface-rim)",
        "--surface-depth": "var(--primitive-shadow-recess)"
      },
      ":is([data-surface=\"control\"], [data-surface=\"field\"], [data-surface=\"fill\"], [data-surface=\"toggle\"], [data-surface=\"toggle-fill\"]):is([aria-expanded=\"true\"], [data-popup-open]):not(input, textarea)": {
        "--surface-tint": "var(--primitive-tint-press)",
        "--surface-rim-top": "var(--surface-rim)",
        "--surface-depth": "var(--primitive-shadow-recess)"
      },
      ":is([data-surface=\"control\"], [data-surface=\"field\"], [data-surface=\"fill\"], [data-surface=\"toggle\"], [data-surface=\"toggle-fill\"]):where(button, a[href], summary, [role=\"button\"], [role=\"tab\"]):where(:not(:disabled, [data-disabled], [aria-disabled=\"true\"])):active": {
        "--surface-tint": "var(--primitive-tint-press)",
        "--surface-rim-top": "var(--surface-rim)",
        "--surface-depth": "var(--primitive-shadow-recess)"
      },
      "[data-surface=\"flat\"]:where(button, a[href], summary, [role=\"button\"], [role=\"tab\"]):where(:not(:disabled, [data-disabled], [aria-disabled=\"true\"])):active": {
        "--surface-tint": "var(--primitive-tint-press)"
      },
      "[data-surface]:is([aria-invalid=\"true\"], :has(> :is(input, textarea)[aria-invalid=\"true\"]))": {
        "--surface-rim": "var(--primitive-destructive-border)",
        "--surface-rim-top": "var(--primitive-destructive-border)"
      },
      "[data-surface][data-surface]:is(:disabled, [data-disabled], [aria-disabled=\"true\"])": {
        "--surface-tint": "transparent",
        "--surface-rim-top": "var(--surface-rim)",
        "--surface-depth": "0 0 #0000"
      },
      "[data-groove]": {
        "flex-shrink": "0",
        "border-width": "0",
        "background-image": "linear-gradient(var(--groove-direction, to bottom), var(--primitive-groove-shadow) 0 1px, var(--primitive-groove-highlight) 1px 2px)"
      },
      "[data-groove=\"horizontal\"]": {
        "height": "2px"
      },
      "[data-groove=\"vertical\"]": {
        "--groove-direction": "to right",
        "width": "2px",
        "align-self": "stretch"
      },
      "[data-carve]": {
        "background-image": "linear-gradient(to bottom, var(--primitive-groove-shadow) 0 1px, var(--primitive-groove-highlight) 1px 2px)",
        "background-repeat": "no-repeat",
        "background-size": "100% 2px"
      },
      "[data-carve=\"top\"]": {
        "background-position": "top"
      },
      "[data-carve=\"bottom\"]": {
        "background-position": "bottom"
      }
    },
    "@layer base": {
      ":where([data-wensity-primitive])": {
        "font-family": "var(--primitive-font-sans)"
      }
    },
    "@utility scrollbar-hidden": {
      "scrollbar-width": "none",
      "-ms-overflow-style": "none",
      "&::-webkit-scrollbar": {
        "display": "none"
      }
    },
    "@keyframes wensity-marquee-x": {
      "from": {
        "transform": "translate3d(0, 0, 0)"
      },
      "to": {
        "transform": "translate3d(-50%, 0, 0)"
      }
    },
    "@keyframes wensity-marquee-x-reverse": {
      "from": {
        "transform": "translate3d(-50%, 0, 0)"
      },
      "to": {
        "transform": "translate3d(0, 0, 0)"
      }
    },
    "@keyframes wensity-morph-rot-cw": {
      "from": {
        "transform": "rotate(0deg)"
      },
      "to": {
        "transform": "rotate(360deg)"
      }
    },
    "@keyframes wensity-morph-rot-ccw": {
      "from": {
        "transform": "rotate(0deg)"
      },
      "to": {
        "transform": "rotate(-360deg)"
      }
    }
  },
